{
  "name": "@arclayer/cli",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "arclayer": "./dist/bin.js"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && tsc-alias --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsc-alias": "^1.8.16",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
