{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/arclayer-hook.py\"",
            "timeout": 15,
            "statusMessage": "Loading Arclayer hook context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/arclayer-hook.py\"",
            "timeout": 15,
            "statusMessage": "Resetting Arclayer turn evidence"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/arclayer-hook.py\"",
            "timeout": 15,
            "statusMessage": "Checking Arclayer command"
          }
        ]
      },
      {
        "matcher": "^apply_patch$|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/arclayer-hook.py\"",
            "timeout": 15,
            "statusMessage": "Checking Arclayer file edit"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/arclayer-hook.py\"",
            "timeout": 15,
            "statusMessage": "Checking Arclayer command result"
          }
        ]
      },
      {
        "matcher": "^apply_patch$|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/arclayer-hook.py\"",
            "timeout": 15,
            "statusMessage": "Suggesting Arclayer validation"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/arclayer-hook.py\"",
            "timeout": 15,
            "statusMessage": "Checking Arclayer handoff evidence"
          }
        ]
      }
    ]
  }
}
