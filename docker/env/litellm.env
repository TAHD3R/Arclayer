# LiteLLM Proxy - Environment Variables
# Master key for LiteLLM admin operations (key creation, rotation).
# Inference requests use Virtual Keys, not the master key.
LITELLM_MASTER_KEY=dev-litellm-master-key-change-me

# PostgreSQL connection for LiteLLM's own state (spend logs, virtual keys).
# Uses the same postgres instance as the Arclayer API, in a separate database.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/litellm

# Required by LiteLLM's /model/new management endpoint.
# Arclayer uses that endpoint to add system model providers from the Admin UI.
STORE_MODEL_IN_DB=True

# LiteLLM proxy config file path (mounted into container)
LITELLM_CONFIG_PATH=/app/config.yaml
