{
  "line_budgets": {
    ".py": 800,
    ".ts": 600,
    ".tsx": 600,
    ".js": 600,
    ".jsx": 600
  },
  "ignore_paths": [
    ".git",
    "node_modules",
    ".venv",
    "dist",
    "build",
    ".turbo",
    "__pycache__",
    ".uv-cache",
    "apps/api/migrations",
    "apps/web/admin/src/routeTree.gen.ts"
  ],
  "frontend_any_scan_roots": [
    "apps/web",
    "packages"
  ],
  "python_scan_roots": [
    "apps/api",
    "plugins"
  ],
  "broad_exception_exclude": [
    "apps/api/tests"
  ]
}
