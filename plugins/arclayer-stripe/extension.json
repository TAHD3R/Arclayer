{
  "name": "arclayer-stripe",
  "version": "1.0.0",
  "entry": "src/plugin.py",
  "requires": {
    "platform": ">=1.0.0",
    "python": ">=3.12"
  },
  "provides": {
    "services": [],
    "middlewares": [],
    "providers": [],
    "connectors": ["billing.stripe"],
    "content_types": []
  },
  "permissions": ["commerce:billing"],
  "config_schema": {
    "type": "object",
    "properties": {
      "apiBaseUrl": { "type": "string", "format": "uri" },
      "webhookToleranceSeconds": { "type": "integer", "minimum": 30, "maximum": 3600 }
    },
    "additionalProperties": false
  },
  "admin": {
    "label_key": "settings:SETTINGS_SYSTEM_PLUGIN_STRIPE_NAME",
    "description_key": "settings:SETTINGS_SYSTEM_PLUGIN_STRIPE_DESC",
    "settings_path": "/system/settings/billing"
  }
}
