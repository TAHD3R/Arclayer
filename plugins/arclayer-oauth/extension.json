{
  "name": "arclayer-oauth",
  "version": "1.0.0",
  "entry": "src/plugin.py",
  "requires": {
    "platform": ">=1.0.0",
    "python": ">=3.12"
  },
  "provides": {
    "services": [],
    "middlewares": [],
    "providers": [],
    "connectors": ["oauth.google", "oauth.github", "oauth.microsoft", "oauth.discord"],
    "content_types": []
  },
  "permissions": ["auth:sso"],
  "config_schema": {
    "type": "object",
    "properties": {
      "enabled": { "type": "boolean" },
      "clientId": { "type": "string" }
    },
    "additionalProperties": false
  },
  "admin": {
    "label_key": "settings:SETTINGS_SYSTEM_PLUGIN_OAUTH_NAME",
    "description_key": "settings:SETTINGS_SYSTEM_PLUGIN_OAUTH_DESC",
    "settings_path": "/system/settings/oauth"
  }
}
