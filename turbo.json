{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "package.json",
    "pnpm-lock.yaml"
  ],
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "typecheck": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "test:integration": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "interactive": true
    },
    "db:upgrade": {
      "cache": false,
      "interactive": true
    },
    "jobs:worker": {
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "jobs:scheduler": {
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "@celestial/api#dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "passThroughEnv": [
        "APPLICATION_ENV",
        "DATABASE_URL",
        "DATABASE__NAME",
        "DATABASE__HOST",
        "VALKEY__DB",
        "RUN_INTEGRATION_TESTS",
        "AUTH__JWT_SECRET",
        "PLUGIN__AUTO_MIGRATE",
        "MAIL__SUPPRESS_SEND"
      ]
    },
    "@celestial/api#test": {
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/pyproject.toml"
      ],
      "passThroughEnv": [
        "APPLICATION_ENV",
        "DATABASE_URL",
        "DATABASE__NAME",
        "DATABASE__HOST",
        "VALKEY__DB",
        "RUN_INTEGRATION_TESTS",
        "AUTH__JWT_SECRET",
        "PLUGIN__AUTO_MIGRATE",
        "MAIL__SUPPRESS_SEND"
      ]
    },
    "@celestial/api#test:integration": {
      "cache": false,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/pyproject.toml"
      ],
      "passThroughEnv": [
        "APPLICATION_ENV",
        "DATABASE_URL",
        "DATABASE__NAME",
        "DATABASE__HOST",
        "VALKEY__DB",
        "RUN_INTEGRATION_TESTS",
        "AUTH__JWT_SECRET",
        "PLUGIN__AUTO_MIGRATE",
        "MAIL__SUPPRESS_SEND"
      ]
    },
    "@celestial/api#lint": {
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/pyproject.toml"
      ]
    },
    "@celestial/api#typecheck": {
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/pyproject.toml"
      ]
    },
    "@celestial/api#db:migrate": {
      "cache": false,
      "interactive": true,
      "passThroughEnv": [
        "APPLICATION_ENV",
        "DATABASE_URL",
        "DATABASE__NAME",
        "DATABASE__HOST",
        "VALKEY__DB",
        "AUTH__JWT_SECRET",
        "PLUGIN__AUTO_MIGRATE"
      ]
    },
    "@celestial/api#db:upgrade": {
      "cache": false,
      "interactive": true,
      "passThroughEnv": [
        "APPLICATION_ENV",
        "DATABASE_URL",
        "DATABASE__NAME",
        "DATABASE__HOST",
        "VALKEY__DB",
        "AUTH__JWT_SECRET",
        "PLUGIN__AUTO_MIGRATE"
      ]
    },
    "@celestial/api#jobs:worker": {
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "passThroughEnv": [
        "APPLICATION_ENV",
        "DATABASE_URL",
        "DATABASE__NAME",
        "DATABASE__HOST",
        "VALKEY__DB",
        "AUTH__JWT_SECRET",
        "PLUGIN__AUTO_MIGRATE"
      ]
    },
    "@celestial/api#jobs:scheduler": {
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "passThroughEnv": [
        "APPLICATION_ENV",
        "DATABASE_URL",
        "DATABASE__NAME",
        "DATABASE__HOST",
        "VALKEY__DB",
        "AUTH__JWT_SECRET",
        "PLUGIN__AUTO_MIGRATE"
      ]
    }
  }
}
