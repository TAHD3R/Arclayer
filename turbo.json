{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "package.json",
    "pnpm-lock.yaml",
    "pyproject.toml",
    "uv.lock",
    "tsconfig.json"
  ],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "APPLICATION_ENV",
    "DATABASE__NAME",
    "DATABASE__HOST",
    "VALKEY__DB",
    "RUN_INTEGRATION_TESTS",
    "AUTH__JWT_SECRET",
    "PLUGIN__AUTO_MIGRATE"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build", "lint", "typecheck"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "typecheck": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "test:integration": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "interactive": true
    },
    "db:upgrade": {
      "cache": false,
      "interactive": true
    },
    "jobs:worker": {
      "cache": false,
      "persistent": true
    },
    "jobs:scheduler": {
      "cache": false,
      "persistent": true
    }
  }
}
