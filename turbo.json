{
  "$schema": "https://v2-10-4.turborepo.dev/schema.json",
  "globalDependencies": [
    "package.json",
    "pnpm-lock.yaml"
  ],
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "typecheck": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "lint:check": {
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "locale:check": {
      "outputs": []
    },
    "test:integration": {
      "cache": false
    },
    "browser:acceptance": {
      "cache": false,
      "outputs": []
    },
    "db:migrate": {
      "cache": false,
      "interactive": true
    },
    "db:upgrade": {
      "cache": false,
      "interactive": true
    },
    "jobs:dispatcher": {
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "jobs:worker:asset-cpu": {
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "jobs:scheduler": {
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "@arclayer/api#dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "passThroughEnv": [
        "APPLICATION_ENV",
        "DATABASE_URL",
        "DATABASE__NAME",
        "DATABASE__HOST",
        "VALKEY__DB",
        "RUN_INTEGRATION_TESTS",
        "AUTH__JWT_SECRET",
        "PLUGIN__AUTO_MIGRATE",
        "MAIL__SUPPRESS_SEND"
      ]
    },
    "@arclayer/api#test": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/api/pyproject.toml"],
      "passThroughEnv": [
        "APPLICATION_ENV",
        "DATABASE_URL",
        "DATABASE__NAME",
        "DATABASE__HOST",
        "VALKEY__DB",
        "RUN_INTEGRATION_TESTS",
        "AUTH__JWT_SECRET",
        "PLUGIN__AUTO_MIGRATE",
        "MAIL__SUPPRESS_SEND"
      ]
    },
    "@arclayer/api#test:integration": {
      "cache": false,
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/api/pyproject.toml"],
      "passThroughEnv": [
        "APPLICATION_ENV",
        "DATABASE_URL",
        "DATABASE__NAME",
        "DATABASE__HOST",
        "VALKEY__DB",
        "RUN_INTEGRATION_TESTS",
        "AUTH__JWT_SECRET",
        "PLUGIN__AUTO_MIGRATE",
        "MAIL__SUPPRESS_SEND"
      ]
    },
    "@arclayer/api#lint": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/api/pyproject.toml"]
    },
    "@arclayer/api#typecheck": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/api/pyproject.toml"]
    },
    "@arclayer/api#db:migrate": {
      "cache": false,
      "interactive": true,
      "passThroughEnv": [
        "APPLICATION_ENV",
        "DATABASE_URL",
        "DATABASE__NAME",
        "DATABASE__HOST",
        "VALKEY__DB",
        "AUTH__JWT_SECRET",
        "PLUGIN__AUTO_MIGRATE"
      ]
    },
    "@arclayer/api#db:upgrade": {
      "cache": false,
      "interactive": true,
      "passThroughEnv": [
        "APPLICATION_ENV",
        "DATABASE_URL",
        "DATABASE__NAME",
        "DATABASE__HOST",
        "VALKEY__DB",
        "AUTH__JWT_SECRET",
        "PLUGIN__AUTO_MIGRATE"
      ]
    },
    "@arclayer/api#jobs:dispatcher": {
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "passThroughEnv": [
        "APPLICATION_ENV",
        "DATABASE_URL",
        "DATABASE__NAME",
        "DATABASE__HOST",
        "VALKEY__DB",
        "AUTH__JWT_SECRET",
        "PLUGIN__AUTO_MIGRATE"
      ]
    },
    "@arclayer/api#jobs:worker:asset-cpu": {
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "passThroughEnv": [
        "APPLICATION_ENV",
        "DATABASE_URL",
        "DATABASE__NAME",
        "DATABASE__HOST",
        "VALKEY__DB",
        "AUTH__JWT_SECRET",
        "PLUGIN__AUTO_MIGRATE"
      ]
    },
    "@arclayer/api#jobs:scheduler": {
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "passThroughEnv": [
        "APPLICATION_ENV",
        "DATABASE_URL",
        "DATABASE__NAME",
        "DATABASE__HOST",
        "VALKEY__DB",
        "AUTH__JWT_SECRET",
        "PLUGIN__AUTO_MIGRATE"
      ]
    }
  }
}
