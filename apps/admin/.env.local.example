#
# SaaS dev mode (Traefik + subdomains)
#
# Copy this file to `.env.local` to enable SaaS-first local development.
#
# Notes:
# - `.env.local` is ignored by git (see `.gitignore`).
# - Requires `pnpm dev:saas` (starts Traefik + infra) and browsers to access:
#   - Admin:  http://app.celestial.localhost
#   - API:    http://api.celestial.localhost
#   - Portal: http://{workspaceSlug}.celestial.localhost
#

VITE_API_BASE_URL=http://api.celestial.localhost
VITE_API_PREFIX=/api/v1

# Admin embeds the Portal editor via an iframe.
# The slug placeholder is replaced with the workspace slug at runtime.
VITE_PORTAL_ORIGIN_TEMPLATE=http://{slug}.celestial.localhost

# Studio (new visual editor app) origin.
# Used to redirect from Admin login to Studio when needed.
# VITE_STUDIO_ORIGIN=http://studio.celestial.localhost
