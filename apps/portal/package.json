{
  "name": "@celestial/portal",
  "version": "2026.02.02-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "if [ -f .env.local ]; then node --env-file=.env.local server/index.mjs; elif [ -f .env.development ]; then node --env-file=.env.development server/index.mjs; else node server/index.mjs; fi",
    "build": "vike build",
    "start": "NODE_ENV=production node server/index.mjs",
    "start:local": "if [ -f .env.local ]; then NODE_ENV=production node --env-file=.env.local server/index.mjs; elif [ -f .env.development ]; then NODE_ENV=production node --env-file=.env.development server/index.mjs; else NODE_ENV=production node server/index.mjs; fi",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "lint": "oxlint -c ./node_modules/@celestial/config/.oxlintrc.json .",
    "format": "oxfmt -c ./node_modules/@celestial/config/.oxfmtrc.json ."
  },
  "dependencies": {
    "@celestial/internal-types": "workspace:*",
    "@celestial/block-protocol": "workspace:*",
    "@celestial/editor-bridge": "workspace:*",
    "@celestial/editor-protocol": "workspace:*",
    "@celestial/renderer": "workspace:*",
    "@celestial/default-theme": "workspace:*",
    "@celestial/runtime": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@celestial/config": "workspace:*",
    "@celestial/vite-plugin": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react-swc": "catalog:",
    "vike": "catalog:",
    "vite": "catalog:"
  }
}
