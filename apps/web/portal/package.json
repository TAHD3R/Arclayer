    "@celestial/web-core": "workspace:*",
    "@celestial/web-types": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@celestial/ox-config": "workspace:*",
    "@celestial/vite": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react-swc": "catalog:",
