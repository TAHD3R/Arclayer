PORT=3100

# Local dev: Portal uses a tiny built-in proxy for /api/* so both SSR and browser requests can stay consistent.
# FastAPI default dev port: 8000
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Vite client-side envs must start with VITE_.
VITE_API_PREFIX=/api/v1
VITE_PORTAL_SITE_ID=00000000-0000-0000-0000-000000000001
