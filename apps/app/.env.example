#
# Local HTTPS control-plane mode (Traefik + arclayer.localhost)
#
# Copy this file to `apps/app/.env.local` when running the Product Application behind Traefik.
# Start the Product Application with the normal repo script (`pnpm app`) and browse:
#   - Product Application: https://app.arclayer.localhost
#   - API (direct):      https://api.arclayer.localhost
#   - Traefik dashboard: https://traefik.arclayer.localhost
#
# The Product Application sends browser API requests through its same-origin `/api` route. Traefik
# forwards that route to the API service, so normal product traffic does not depend
# on cross-origin preflight requests during API reloads.
#

VITE_API_BASE_URL=https://app.arclayer.localhost
VITE_API_PREFIX=/api/v1
VITE_PLATFORM_ORIGIN=https://platform.arclayer.localhost
VITE_HMR_PROTOCOL=wss
VITE_HMR_HOST=app.arclayer.localhost
VITE_HMR_CLIENT_PORT=443

# Default public site origin used to prefill setup/settings URLs.
VITE_SITE_ORIGIN=https://app.arclayer.localhost
