# SaaS dev mode (Traefik + subdomains)
#
# Copy this file to `apps/api/.env.local` to enable SaaS-first local development.
#
# Notes:
# - `.env.local` is ignored by git.
# - Requires `pnpm dev:saas` (starts Traefik + infra) and browsers to access:
#   - Admin:  http://app.celestial.localhost
#   - API:    http://api.celestial.localhost
#   - Portal: http://{workspaceSlug}.celestial.localhost
#

# -----------------------------------------------------------------------------
# Application (Settings.application)
# -----------------------------------------------------------------------------
APPLICATION__DEPLOYMENT_MODE=saas
APPLICATION__FRONTEND_BASE_URL=http://app.celestial.localhost

# -----------------------------------------------------------------------------
# SaaS (Settings.saas)
# -----------------------------------------------------------------------------
SAAS__BASE_DOMAIN=celestial.localhost
SAAS__ADMIN_URL=http://app.celestial.localhost

# -----------------------------------------------------------------------------
# Middlewares (Settings.middleware)
# -----------------------------------------------------------------------------
MIDDLEWARE__CORS_ENABLED=1
MIDDLEWARE__CORS_ALLOW_CREDENTIALS=1

# Platform fixed hosts are derived dynamically from SAAS__BASE_DOMAIN:
# - http://app.{base}
# - http://api.{base}
MIDDLEWARE__CORS_ALLOW_ORIGIN_DYNAMIC=1

# Tenant subdomains: http://{slug}.celestial.localhost (and any dev ports)
MIDDLEWARE__CORS_ALLOW_ORIGIN_REGEX=^https?://[a-z0-9-]+\.celestial\.localhost(:\d+)?$

MIDDLEWARE__CORS_ALLOW_METHODS='["GET","POST","PUT","PATCH","DELETE","OPTIONS"]'
MIDDLEWARE__CORS_ALLOW_HEADERS='["Content-Type","Authorization","X-CSRF-Token","X-Request-Id","Accept-Language"]'
MIDDLEWARE__CORS_EXPOSE_HEADERS='["X-Request-Id"]'
MIDDLEWARE__CORS_MAX_AGE=600

# -----------------------------------------------------------------------------
# Auth / JWT (Settings.auth)
# -----------------------------------------------------------------------------
# Cross-subdomain SSO: store refresh token in an HttpOnly cookie.
AUTH__COOKIE__ENABLED=1
AUTH__COOKIE__DOMAIN=.celestial.localhost
AUTH__COOKIE__SECURE=0
AUTH__COOKIE__SAMESITE=lax
