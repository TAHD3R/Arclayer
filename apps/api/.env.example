# CelestialCMS API - Environment Variables Example
#
# Notes:
# - This file is meant as a reference template. Copy to `apps/api/.env` (or `.env.<env>`) and adjust.
# - Values in OS env vars should override values from dotenv files.
# - Arrays are JSON strings (e.g. '["GET","POST"]').
#
# ENV
APP_ENV=development

# -----------------------------------------------------------------------------
# Application (Settings.application)
# -----------------------------------------------------------------------------
APPLICATION__API_PREFIX=/api
APPLICATION__API_VERSION_PREFIX=/v1

# Deployment mode:
# - self_host: expose deployment settings in admin (storage/mail)
# - saas: hide deployment settings and hard-disable instance-level system endpoints
APPLICATION__DEPLOYMENT_MODE=self_host

APPLICATION__APP_HOST=127.0.0.1
APPLICATION__APP_PORT=8000
APPLICATION__APP_NAME="Celestial Framework API"
APPLICATION__APP_VERSION="2026.01.18-dev"
APPLICATION__APP_DESCRIPTION="Celestial is a light-weight, modular plugin-based ASGI python framework based on FastAPI."

# OpenAPI schema & docs routing
APPLICATION__APP_OPENAPI_URL=/openapi.json
APPLICATION__APP_DOCS_URL=/docs
APPLICATION__APP_REDOC_URL=/redoc

# Static assets (optional)
APPLICATION__STATIC_ENABLED=0
APPLICATION__STATIC_DIR=static
APPLICATION__STATIC_URL=/static

# Frontend URL (used in emails, reset-password links, etc.)
APPLICATION__FRONTEND_BASE_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Storage (Settings.storage)
# -----------------------------------------------------------------------------
# provider: local | s3
STORAGE__PROVIDER=local

# Local storage
STORAGE__LOCAL_ROOT_DIR=data/uploads
STORAGE__LOCAL_TMP_DIR=data/uploads/.tmp

# Optional public base URL (e.g. CDN) for building absolute asset URLs
STORAGE__PUBLIC_BASE_URL=

# S3-compatible storage (required when STORAGE__PROVIDER=s3)
STORAGE__S3_ENDPOINT_URL=
STORAGE__S3_REGION=
STORAGE__S3_BUCKET=
STORAGE__S3_ACCESS_KEY_ID=
STORAGE__S3_SECRET_ACCESS_KEY=
STORAGE__S3_FORCE_PATH_STYLE=0
STORAGE__S3_PRESIGN_EXPIRES_SECONDS=900

# Upload policies
STORAGE__RECYCLE_BIN_RETENTION_DAYS=90
STORAGE__UPLOAD_CHUNK_SIZE_MB=8
STORAGE__UPLOAD_MAX_FILE_SIZE_MB=2048
STORAGE__UPLOAD_MAX_AVATAR_SIZE_MB=10
STORAGE__UPLOAD_MAX_SITE_LOGO_SIZE_MB=20
STORAGE__UPLOAD_MAX_FAVICON_SIZE_MB=2
STORAGE__UPLOAD_SESSION_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Logging (Settings.logging)
# -----------------------------------------------------------------------------
LOGGING__LEVEL=INFO

# If null/empty, logging format may be chosen based on APP_ENV.
LOGGING__JSON_LOGS=

LOGGING__LOG_DIR=apps/api/logs
LOGGING__ROTATION=1d
LOGGING__RETENTION=7d
LOGGING__ASYNC_ENABLED=0
LOGGING__OMIT_TORTOISE_LOGS=1
LOGGING__OMIT_UVICORN_ACCESS_LOGS=1

LOGGING__TRACE_HEADER_NAME=X-Trace-Id
LOGGING__REQUEST_LOG_OMIT_PATHS='["/metrics","/openapi.json","/docs","/redoc","/spotlight","/favicon.ico"]'
LOGGING__REQUEST_LOG_OMIT_PATH_PREFIXES='["/static","/_docs"]'

# -----------------------------------------------------------------------------
# Database (Settings.database)
# -----------------------------------------------------------------------------
DATABASE__ENABLED=0
DATABASE__ENGINE=tortoise.backends.asyncpg
DATABASE__HOST=127.0.0.1
DATABASE__PORT=5432
DATABASE__USER=postgres
DATABASE__PASSWORD=
DATABASE__NAME=celestial
DATABASE__POOL_SIZE=10
DATABASE__USE_TZ=1
DATABASE__TIMEZONE=UTC
DATABASE__CORE_MODELS='["apps.api.modules"]'
DATABASE__PLUGIN_PACKAGES='["apps.api.plugins"]'
DATABASE__MODELS_MAX_DEPTH=4

# -----------------------------------------------------------------------------
# Valkey / Redis (Settings.valkey)
# -----------------------------------------------------------------------------
VALKEY__ENABLED=0
VALKEY__HOST=127.0.0.1
VALKEY__PORT=6379
VALKEY__DB=0
VALKEY__USERNAME=
VALKEY__PASSWORD=
VALKEY__PREFIX=

# Rate limiter toggles (requires Valkey enabled)
VALKEY__LIMITER_ENABLED=0
VALKEY__LIMITER_PREFIX=fastapi-limiter
VALKEY__DEFAULT_TTL=

# -----------------------------------------------------------------------------
# Analytics (Settings.analytics)
# -----------------------------------------------------------------------------
ANALYTICS__ENABLED=1
ANALYTICS__AUDIT_LOG__ENABLED=1

# In-process ingestion tuning
ANALYTICS__AUDIT_LOG__QUEUE_MAXSIZE=5000
ANALYTICS__AUDIT_LOG__FLUSH_BATCH_SIZE=200
ANALYTICS__AUDIT_LOG__FLUSH_INTERVAL_MS=200

# Payload sanitization bounds
ANALYTICS__AUDIT_LOG__MAX_PROPERTY_KEYS=50
ANALYTICS__AUDIT_LOG__MAX_STRING_LENGTH=512
ANALYTICS__AUDIT_LOG__MAX_DEPTH=5

# Retention (cleanup executed by arq cron jobs)
ANALYTICS__AUDIT_LOG__RETENTION_ENABLED=1
ANALYTICS__AUDIT_LOG__RETENTION_DAYS=90
ANALYTICS__AUDIT_LOG__RETENTION_BATCH_SIZE=2000
ANALYTICS__AUDIT_LOG__RETENTION_MAX_DELETE_PER_RUN=20000

# Allowlist patterns for stored audit events (supports fnmatch globs).
ANALYTICS__AUDIT_LOG__EVENT_ALLOWLIST='["auth.*","workspace.*","rbac.*","system.*","settings.updated","plugin.*","asset.*"]'

# -----------------------------------------------------------------------------
# arq worker (Settings.arq)
# -----------------------------------------------------------------------------
# arq requires Valkey/Redis. Run worker as a separate process:
#   pnpm -C apps/api jobs:worker
ARQ__ENABLED=0
ARQ__QUEUE_NAME=celestial:arq
# If empty, defaults to VALKEY DSN.
ARQ__REDIS_DSN=

# -----------------------------------------------------------------------------
# Observability (Settings.observability)
# -----------------------------------------------------------------------------
OBSERVABILITY__SENTRY_ENABLED=0
OBSERVABILITY__SENTRY_DSN=
OBSERVABILITY__SENTRY_ENVIRONMENT=
OBSERVABILITY__SENTRY_RELEASE=
OBSERVABILITY__SENTRY_TRACES_SAMPLE_RATE=0.0
OBSERVABILITY__SENTRY_PROFILES_SAMPLE_RATE=0.0
OBSERVABILITY__SENTRY_SEND_PII=0

OBSERVABILITY__METRICS_ENABLED=0
OBSERVABILITY__METRICS_PATH=/metrics
OBSERVABILITY__METRICS_INCLUDE_IN_SCHEMA=0

# -----------------------------------------------------------------------------
# Middlewares (Settings.middleware)
# -----------------------------------------------------------------------------
MIDDLEWARE__CORS_ENABLED=0
MIDDLEWARE__CORS_ALLOW_ORIGINS='[]'
MIDDLEWARE__CORS_ALLOW_METHODS='["GET"]'
MIDDLEWARE__CORS_ALLOW_HEADERS='[]'
MIDDLEWARE__CORS_ALLOW_CREDENTIALS=0
MIDDLEWARE__CORS_ALLOW_ORIGIN_REGEX=
MIDDLEWARE__CORS_EXPOSE_HEADERS='[]'
MIDDLEWARE__CORS_MAX_AGE=600

MIDDLEWARE__GZIP_ENABLED=0
MIDDLEWARE__GZIP_MINIMUM_SIZE=500
MIDDLEWARE__GZIP_COMPRESSLEVEL=9

MIDDLEWARE__TRUSTED_HOST_ENABLED=0
MIDDLEWARE__TRUSTED_HOSTS='["*"]'
MIDDLEWARE__TRUSTED_HOST_WWW_REDIRECT=1

# Only effective in production
MIDDLEWARE__HTTPS_REDIRECT_ENABLED=0

MIDDLEWARE__CSRF_ENABLED=0
MIDDLEWARE__CSRF_HEADER_NAME=X-CSRF-Token
MIDDLEWARE__CSRF_COOKIE_NAME=csrf_token
MIDDLEWARE__CSRF_COOKIE_SECURE=0
MIDDLEWARE__CSRF_COOKIE_HTTPONLY=0
MIDDLEWARE__CSRF_COOKIE_SAMESITE=lax
MIDDLEWARE__CSRF_SAFE_METHODS='["GET","HEAD","OPTIONS","TRACE"]'
MIDDLEWARE__CSRF_TOKEN_BYTES=32

# -----------------------------------------------------------------------------
# Auth / JWT (Settings.auth)
# -----------------------------------------------------------------------------
AUTH__JWT_SECRET=
AUTH__JWT_ALGORITHM=HS256
AUTH__JWT_ISSUER=celestial
AUTH__JWT_AUDIENCE=celestial
AUTH__ACCESS_TOKEN_TTL_SECONDS=900
AUTH__REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH__RESET_TOKEN_TTL_SECONDS=900
AUTH__ALLOW_PUBLIC_REGISTER=0
AUTH__PASSWORD_HASH_ITERATIONS=120000
AUTH__PASSWORD_HASH_SALT_BYTES=16

# -----------------------------------------------------------------------------
# Email (Settings.email)
# -----------------------------------------------------------------------------
MAIL__ENABLED=0
MAIL__USERNAME=
MAIL__PASSWORD=
MAIL__MAIL_FROM=noreply@example.com
MAIL__MAIL_FROM_NAME="Celestial CMS"
MAIL__SERVER=localhost
MAIL__PORT=587
MAIL__STARTTLS=1
MAIL__SSL_TLS=0
MAIL__USE_CREDENTIALS=1
MAIL__VALIDATE_CERTS=1
MAIL__SUPPRESS_SEND=0
MAIL__TEMPLATE_DIR=

# -----------------------------------------------------------------------------
# Plugin system (Settings.plugin)
# -----------------------------------------------------------------------------
PLUGIN__ENABLED=1
PLUGIN__ROOT_DIR=plugins
PLUGIN__AUTO_MIGRATE=1
PLUGIN__AUTO_RESTART=1
PLUGIN__MIGRATION_LOCK_TTL_SECONDS=300
PLUGIN__MIGRATION_LOCK_TIMEOUT_SECONDS=60
PLUGIN__RESTART_POLL_INTERVAL_SECONDS=2.0
PLUGIN__RESTART_JITTER_SECONDS=5.0

# -----------------------------------------------------------------------------
# One-time setup (Settings.setup)
# -----------------------------------------------------------------------------
SETUP__ENABLED=1
SETUP__TOKEN=
SETUP__MASTER_KEY_PATH=data/secrets/master.key

# -----------------------------------------------------------------------------
# Integration test helpers (Settings.testing)
# -----------------------------------------------------------------------------
TEST_DATABASE__ENABLED=0
TEST_DATABASE__NAME=celestial_test
TEST_VALKEY__ENABLED=0
TEST_VALKEY__DB=15
TEST_VALKEY__PREFIX=test
TEST_VALKEY__DEFAULT_TTL=5

# -----------------------------------------------------------------------------
# Public ID encoding (Settings.public_id)
# -----------------------------------------------------------------------------
# Stable secret for reversible "public id" encoding (UUID-internal, nanoid-like external).
# Use a unique secret in production and keep it stable across deploys.
PUBLIC_ID__SECRET="dev-public-id-secret"
