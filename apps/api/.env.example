# Arclayer API - Environment Variables Example
#
# Notes:
# - This file is meant as a reference template. Copy to `apps/api/.env` (or `.env.<env>`) and adjust.
# - Values in OS env vars should override values from dotenv files.
# - Arrays are JSON strings (e.g. '["GET","POST"]').
# - Booleans use true/false for readability.
#
# ENV
APP_ENV=development

# -----------------------------------------------------------------------------
# Application (Settings.application)
# -----------------------------------------------------------------------------
APPLICATION__API_PREFIX=/api
APPLICATION__API_VERSION_PREFIX=/v1
APPLICATION__CONTENT_API_PREFIX=/content-api
APPLICATION__MANAGEMENT_API_PREFIX=/management-api

APPLICATION__APP_HOST=127.0.0.1
APPLICATION__APP_PORT=8000
APPLICATION__APP_NAME="Arclayer API"
APPLICATION__APP_VERSION="2026.01.18-dev"
APPLICATION__APP_DESCRIPTION="Structured content, visually built."

# OpenAPI schema & docs routing
APPLICATION__APP_OPENAPI_URL=/openapi.json
APPLICATION__APP_DOCS_URL=/docs
APPLICATION__APP_REDOC_URL=/redoc

# Static assets (optional)
APPLICATION__STATIC_ENABLED=false
APPLICATION__STATIC_DIR=static
APPLICATION__DATA_DIR=data
APPLICATION__STATIC_URL=/static

# Frontend URL (used in emails, reset-password links, etc.)
APPLICATION__FRONTEND_BASE_URL=https://app.arclayer.localhost

# -----------------------------------------------------------------------------
# Storage (Settings.storage)
# -----------------------------------------------------------------------------
# provider: local | s3
STORAGE__DEFAULT_PROFILE_KEY=env-default
STORAGE__PROVIDER=s3

# Local storage
STORAGE__LOCAL_ROOT_DIR=data/uploads
STORAGE__LOCAL_TMP_DIR=data/uploads/.tmp

# Optional public base URL (e.g. CDN) for building absolute asset URLs.
# Local Docker defaults use RustFS behind Traefik.
STORAGE__PUBLIC_BASE_URL=https://storage.arclayer.localhost/arclayer-assets-public
STORAGE__PUBLIC_DELIVERY_MODE=auto

# S3-compatible storage (required when STORAGE__PROVIDER=s3)
STORAGE__S3_ENDPOINT_URL=https://storage.arclayer.localhost
STORAGE__S3_REGION=us-east-1
STORAGE__S3_BUCKET=arclayer-assets
STORAGE__S3_PUBLIC_BUCKET=arclayer-assets-public
STORAGE__S3_ACCESS_KEY_ID=rustfsadmin
STORAGE__S3_SECRET_ACCESS_KEY=rustfsadmin
STORAGE__S3_FORCE_PATH_STYLE=true
STORAGE__S3_PRESIGN_EXPIRES_SECONDS=900

# Upload policies
STORAGE__RECYCLE_BIN_RETENTION_DAYS=90
STORAGE__UPLOAD_CHUNK_SIZE_MB=8
STORAGE__UPLOAD_MAX_FILE_SIZE_MB=2048
STORAGE__UPLOAD_MAX_AVATAR_SIZE_MB=10
STORAGE__UPLOAD_MAX_SITE_LOGO_SIZE_MB=20
STORAGE__UPLOAD_MAX_FAVICON_SIZE_MB=2
STORAGE__UPLOAD_SESSION_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Search (Settings.search)
# -----------------------------------------------------------------------------
SEARCH__ENABLED=false
SEARCH__BACKEND=meilisearch
SEARCH__INDEX_PREFIX=arclayer_content
SEARCH__MEILISEARCH_URL=http://127.0.0.1:7700
SEARCH__MEILISEARCH_API_KEY=
SEARCH__REQUEST_TIMEOUT_SECONDS=5.0

# -----------------------------------------------------------------------------
# Logging (Settings.logging)
# -----------------------------------------------------------------------------
LOGGING__LEVEL=INFO

LOGGING__JSON_LOGS=false

LOGGING__LOG_DIR=apps/api/logs
LOGGING__ROTATION=1d
LOGGING__RETENTION=7d
LOGGING__ASYNC_ENABLED=false
LOGGING__OMIT_TORTOISE_LOGS=true
LOGGING__OMIT_UVICORN_ACCESS_LOGS=true

LOGGING__TRACE_HEADER_NAME=X-Trace-Id
LOGGING__REQUEST_LOG_OMIT_PATHS='["/metrics","/openapi.json","/docs","/redoc","/favicon.ico"]'
LOGGING__REQUEST_LOG_OMIT_PATH_PREFIXES='["/static"]'
LOGGING__WATCHFILES_LEVEL=INFO

# -----------------------------------------------------------------------------
# Database (Settings.database)
# -----------------------------------------------------------------------------
DATABASE__ENABLED=true
DATABASE__ENGINE=tortoise.backends.asyncpg
DATABASE__HOST=127.0.0.1
DATABASE__PORT=5432
DATABASE__USER=postgres
DATABASE__PASSWORD=postgres
DATABASE__DATABASE=arclayer
DATABASE__POOL_SIZE=10
DATABASE__USE_TZ=true
DATABASE__TIMEZONE=UTC
DATABASE__CORE_MODELS='["src.models"]'
DATABASE__MODELS_MAX_DEPTH=4

# -----------------------------------------------------------------------------
# Project database provisioning (Settings.project_databases)
# -----------------------------------------------------------------------------
PROJECT_DATABASES__ENABLED=false
PROJECT_DATABASES__HOST=127.0.0.1
PROJECT_DATABASES__PORT=5432
PROJECT_DATABASES__USER=postgres
PROJECT_DATABASES__PASSWORD=postgres
PROJECT_DATABASES__DATABASE=postgres

# -----------------------------------------------------------------------------
# Valkey / Redis (Settings.valkey)
# -----------------------------------------------------------------------------
VALKEY__ENABLED=true
VALKEY__HOST=127.0.0.1
VALKEY__PORT=6379
VALKEY__DB=0
VALKEY__USERNAME=arclayer
VALKEY__PASSWORD=arclayer_dev
VALKEY__PREFIX=

VALKEY__DEFAULT_TTL=180

# -----------------------------------------------------------------------------
# Analytics (Settings.analytics)
# -----------------------------------------------------------------------------
ANALYTICS__ENABLED=true
ANALYTICS__AUDIT_LOG__ENABLED=true

# In-process ingestion tuning
ANALYTICS__AUDIT_LOG__QUEUE_MAXSIZE=5000
ANALYTICS__AUDIT_LOG__FLUSH_BATCH_SIZE=200
ANALYTICS__AUDIT_LOG__FLUSH_INTERVAL_MS=200

# Payload sanitization bounds
ANALYTICS__AUDIT_LOG__MAX_PROPERTY_KEYS=50
ANALYTICS__AUDIT_LOG__MAX_STRING_LENGTH=512
ANALYTICS__AUDIT_LOG__MAX_DEPTH=5

# Retention (cleanup executed by Taskiq scheduled jobs)
ANALYTICS__AUDIT_LOG__RETENTION_ENABLED=true
ANALYTICS__AUDIT_LOG__RETENTION_DAYS=90
ANALYTICS__AUDIT_LOG__RETENTION_BATCH_SIZE=2000
ANALYTICS__AUDIT_LOG__RETENTION_MAX_DELETE_PER_RUN=20000

# Allowlist patterns for stored audit events (supports fnmatch globs).
ANALYTICS__AUDIT_LOG__EVENT_ALLOWLIST='["auth.*","me.api_key.*","project.*","workspace.*","rbac.*","system.*","settings.updated","plugin.*","asset.*"]'

# -----------------------------------------------------------------------------
# Taskiq worker/scheduler (Settings.taskiq)
# -----------------------------------------------------------------------------
# Taskiq requires Valkey/Redis. Run as separate processes:
#   pnpm -C apps/api jobs:worker
#   pnpm -C apps/api jobs:scheduler
TASKIQ__ENABLED=true
TASKIQ__QUEUE_NAME=arclayer:taskiq
# If empty, defaults to VALKEY DSN.
TASKIQ__REDIS_DSN=redis://arclayer:arclayer_dev@127.0.0.1:6379/0

# Middlewares (Settings.middleware)
# -----------------------------------------------------------------------------
MIDDLEWARE__GZIP_ENABLED=false
MIDDLEWARE__GZIP_MINIMUM_SIZE=500
MIDDLEWARE__GZIP_COMPRESSLEVEL=9

MIDDLEWARE__TRUSTED_HOST_ENABLED=false
MIDDLEWARE__TRUSTED_HOSTS='["*"]'
MIDDLEWARE__TRUSTED_HOST_WWW_REDIRECT=true

# Only effective in production
MIDDLEWARE__HTTPS_REDIRECT_ENABLED=false

# -----------------------------------------------------------------------------
# Security / FastAPI Guard (Settings.security)
# -----------------------------------------------------------------------------
SECURITY__ENABLED=true
SECURITY__PASSIVE_MODE=false
SECURITY__ENABLE_REDIS=false
SECURITY__REDIS_URL=redis://arclayer:arclayer_dev@127.0.0.1:6379/0
SECURITY__REDIS_PREFIX=arclayer:guard:
SECURITY__WHITELIST='[]'
SECURITY__BLACKLIST='[]'
SECURITY__WHITELIST_COUNTRIES='[]'
SECURITY__BLOCKED_COUNTRIES='[]'
SECURITY__BLOCKED_USER_AGENTS='[]'
SECURITY__AUTO_BAN_THRESHOLD=10
SECURITY__AUTO_BAN_DURATION=3600
SECURITY__CUSTOM_LOG_FILE=
SECURITY__LOG_SUSPICIOUS_LEVEL=WARNING
SECURITY__LOG_REQUEST_LEVEL=
SECURITY__LOG_FORMAT=text
SECURITY__CUSTOM_ERROR_RESPONSES='{}'
SECURITY__ENABLE_RATE_LIMITING=true
SECURITY__RATE_LIMIT=3000
SECURITY__RATE_LIMIT_WINDOW=60
SECURITY__ENFORCE_HTTPS=false
SECURITY__SECURITY_HEADERS='{"enabled": true, "hsts": {"max_age": 31536000, "include_subdomains": true, "preload": false}, "frame_options": "SAMEORIGIN", "content_type_options": "nosniff", "xss_protection": "1; mode=block", "referrer_policy": "strict-origin-when-cross-origin", "permissions_policy": "geolocation=(), microphone=(), camera=()"}'
SECURITY__ENABLE_CORS=true
SECURITY__CORS_ALLOW_ORIGINS='["https://app.arclayer.localhost","https://api.arclayer.localhost","http://localhost:5173","http://localhost:3000"]'
SECURITY__CORS_ALLOW_METHODS='["GET","POST","PUT","PATCH","DELETE","OPTIONS"]'
SECURITY__CORS_ALLOW_HEADERS='["Content-Type","Authorization","X-CSRF-Token","X-Request-Id","Accept-Language"]'
SECURITY__CORS_ALLOW_CREDENTIALS=true
SECURITY__CORS_EXPOSE_HEADERS='["X-Request-Id"]'
SECURITY__CORS_MAX_AGE=600
SECURITY__BLOCK_CLOUD_PROVIDERS='[]'
SECURITY__CLOUD_IP_REFRESH_INTERVAL=3600
SECURITY__EXCLUDE_PATHS='["/docs","/redoc","/openapi.json","/favicon.ico","/static"]'
SECURITY__ENABLE_IP_BANNING=false
SECURITY__ENABLE_PENETRATION_DETECTION=false
SECURITY__CUSTOM_PENETRATION_PATTERNS='[]'
SECURITY__CSRF__ENABLED=true
SECURITY__CSRF__HEADER_NAME="X-CSRF-Token"
SECURITY__CSRF__COOKIE_NAME="csrf_token"
SECURITY__CSRF__COOKIE_SECURE=false
SECURITY__CSRF__COOKIE_HTTPONLY=false
SECURITY__CSRF__COOKIE_SAMESITE="lax"
SECURITY__CSRF__SAFE_METHODS='["GET","HEAD","OPTIONS","TRACE"]'
SECURITY__CSRF__PROTECTED_PATH_PREFIXES='["/api"]'
SECURITY__CSRF__EXEMPT_PATH_PREFIXES='["/content-api"]'
SECURITY__CSRF__TRUSTED_ORIGINS='["https://app.arclayer.localhost","https://api.arclayer.localhost","http://localhost:5173","http://localhost:3000"]'
SECURITY__CSRF__TOKEN_BYTES=32
SECURITY__MASTER_KEY_PATH=data/secrets/master.key
SECURITY__SIGNING_PRIVATE_KEY_PATH=data/secrets/signing.ed25519
SECURITY__SIGNING_PUBLIC_KEY_PATH=data/secrets/signing.ed25519.pub

# -----------------------------------------------------------------------------
# Auth / JWT (Settings.auth)
# -----------------------------------------------------------------------------
AUTH__JWT_SECRET=dev-jwt-secret-change-me
AUTH__JWT_ALGORITHM=HS256
AUTH__JWT_ISSUER=arclayer
AUTH__JWT_AUDIENCE=arclayer
AUTH__ACCESS_TOKEN_TTL_SECONDS=900
AUTH__SYS_ACCESS_TOKEN_TTL_SECONDS=300
AUTH__REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH__RESET_TOKEN_TTL_SECONDS=900
AUTH__ALLOW_PUBLIC_REGISTER=false
AUTH__PASSWORD_HASH_ITERATIONS=120000
AUTH__PASSWORD_HASH_SALT_BYTES=16

# Refresh-token cookie support for shared-domain local HTTPS development.
AUTH__COOKIE__ENABLED=true
AUTH__COOKIE__NAME=arclayer_refresh_token
AUTH__COOKIE__DOMAIN=.arclayer.localhost
AUTH__COOKIE__SECURE=true
AUTH__COOKIE__SAMESITE=lax

# -----------------------------------------------------------------------------
# Email (Settings.email)
# -----------------------------------------------------------------------------
MAIL__ENABLED=true
MAIL__USERNAME=
MAIL__PASSWORD=
MAIL__MAIL_FROM=noreply@example.com
MAIL__MAIL_FROM_NAME="Arclayer"
MAIL__SERVER=127.0.0.1
MAIL__PORT=1025
MAIL__STARTTLS=false
MAIL__SSL_TLS=false
MAIL__USE_CREDENTIALS=false
MAIL__VALIDATE_CERTS=false
MAIL__SUPPRESS_SEND=false
MAIL__TEMPLATE_DIR=
MAIL__DEFAULT_PROVIDER=smtp
MAIL__FALLBACK_CHAIN='[]'
MAIL__RETRY_MAX_ATTEMPTS=3
MAIL__RESEND_API_KEY=
MAIL__CLOUDFLARE_API_TOKEN=
MAIL__SES_REGION=

# -----------------------------------------------------------------------------
# Public ID encoding (Settings.public_id)
# -----------------------------------------------------------------------------
# Stable secret for reversible "public id" encoding (UUID-internal, nanoid-like external).
# Use a unique secret in production and keep it stable across deploys.
PUBLIC_ID__SECRET="dev-public-id-secret"
PUBLIC_ID__ROUNDS=8
PUBLIC_ID__ACCEPT_RAW_UUID_INPUT=true

# -----------------------------------------------------------------------------
# SaaS / hostnames (Settings.saas)
# -----------------------------------------------------------------------------
SAAS__BASE_DOMAIN=arclayer.localhost
SAAS__ADMIN_URL=https://app.arclayer.localhost

# -----------------------------------------------------------------------------
# AI / LLM Infrastructure (Settings.ai)
# -----------------------------------------------------------------------------
# LiteLLM proxy connection
AI__LITELLM_BASE_URL=http://localhost:4000
AI__LITELLM_MASTER_KEY=
AI__LITELLM_TIMEOUT_SECONDS=120.0

# Default LLM model and token limit
AI__DEFAULT_MODEL=gpt-4o-mini
AI__DEFAULT_MAX_TOKENS=4096

# Budget defaults (microdollars: 1 dollar = 1,000,000 µ$)
# $100/month default per workspace
AI__DEFAULT_MONTHLY_LIMIT_MICROS=100000000
AI__RESERVATION_TTL_SECONDS=300

# Rate limiting
AI__RATE_LIMIT_ENABLED=true
AI__RATE_LIMIT_CAPACITY=100
AI__RATE_LIMIT_WINDOW_SECONDS=60

# Provider data retention — when false, sends opt-out to providers
AI__DATA_RETENTION_ENABLED=false

# Mock mode for development without real provider keys
AI__MOCK_ENABLED=false

# Observability
AI__AUDIT_LOG_ENABLED=true
AI__METRICS_ENABLED=true

# Provider API keys (optional; can also be configured via LiteLLM proxy)
AI__OPENAI_API_KEY=
AI__ANTHROPIC_API_KEY=
