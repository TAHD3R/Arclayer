{
  "name": "@arclayer/api",
  "private": true,
  "author": {
    "name": "Jassar Ayiken",
    "email": "aspj6771@gmail.com",
    "url": "https://github.com/TAHD4R"
  },
  "scripts": {
    "uv": "uv run",
    "lock": "uv lock",
    "install": "uv sync",
    "dev": "pnpm openapi:sync && uv run uvicorn src.main:app --reload --host 0.0.0.0 --port 8000 --workers 8",
    "openapi:sync": "uv run python -m scripts.sync_openapi_sdk",
    "openapi:export": "uv run python -m scripts.export_openapi",
    "graphql:schema:export": "uv run python -m scripts.export_graphql_schema",
    "graphql:schema:verify": "uv run python -m scripts.verify_graphql_schema",
    "lint": "uv run ruff check . --fix",
    "format": "uv run ruff format .",
    "typecheck": "uv run ty check --output-format concise",
    "test": "uv run pytest -c pyproject.toml",
    "test:integration": "RUN_INTEGRATION_TESTS=1 MAIL__SUPPRESS_SEND=${MAIL__SUPPRESS_SEND:-1} uv run pytest -c pyproject.toml -m integration",
    "test:quick": "uv run pytest -c pyproject.toml -q tests/test_tenant_context.py tests/modules/assets/test_org_assets_router_unit.py tests/modules/auth/test_auth_me_avatar_binding_align_unit.py --no-cov",
    "db:migrate": "uv run python -m tortoise -c src.core.database.orm.TORTOISE_ORM makemigrations",
    "db:upgrade": "uv run python -m tortoise -c src.core.database.orm.TORTOISE_ORM upgrade",
    "jobs:worker:agent-io": "uv run python -m scripts.run_taskiq_worker agent-io",
    "jobs:worker:render-browser": "uv run python -m scripts.run_taskiq_worker render-browser",
    "jobs:worker:asset-cpu": "uv run python -m scripts.run_taskiq_worker asset-cpu",
    "jobs:worker:publish": "uv run python -m scripts.run_taskiq_worker publish",
    "jobs:worker:connector": "uv run python -m scripts.run_taskiq_worker connector",
    "jobs:worker:maintenance": "uv run python -m scripts.run_taskiq_worker maintenance",
    "jobs:dispatcher": "uv run python -m src.platform.jobs.composition.producer",
    "jobs:scheduler": "uv run taskiq scheduler src.platform.jobs.composition.scheduler:scheduler"
  }
}
