# Deployment
APPLICATION__DEPLOYMENT_MODE=saas
APPLICATION__FRONTEND_BASE_URL=https://app.celestial.app

# SaaS domain
SAAS__BASE_DOMAIN=celestial.app
SAAS__ADMIN_URL=https://app.celestial.app

# CORS (SaaS cross-subdomain)
MIDDLEWARE__CORS_ENABLED=1
MIDDLEWARE__CORS_ALLOW_CREDENTIALS=1
MIDDLEWARE__CORS_ALLOW_ORIGIN_DYNAMIC=1
MIDDLEWARE__CORS_ALLOW_ORIGIN_REGEX=^https://[a-z0-9-]+\.celestial\.app$
MIDDLEWARE__CORS_ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
MIDDLEWARE__CORS_ALLOW_HEADERS=["Content-Type","Authorization","X-CSRF-Token","X-Request-Id","Accept-Language"]
MIDDLEWARE__CORS_EXPOSE_HEADERS=["X-Request-Id"]

# HTTPS redirect
MIDDLEWARE__HTTPS_REDIRECT_ENABLED=1
