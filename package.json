{
  "name": "arclayer-framework",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --filter=@arclayer/app --filter=@arclayer/platform --filter=@arclayer/api",
    "dev:docker": "pnpm docker && pnpm dev",
    "build": "turbo run build --filter=@arclayer/app --filter=@arclayer/platform",
    "format": "turbo run format --filter=@arclayer/app --filter=@arclayer/platform --filter=@arclayer/api",
    "check": "turbo run lint:check format:check typecheck test locale:check --filter=@arclayer/app --filter=@arclayer/platform --filter=@arclayer/api",
    "app": "turbo run dev --filter=@arclayer/app",
    "app:build": "turbo run build --filter=@arclayer/app",
    "app:check": "turbo run lint:check format:check typecheck test locale:check --filter=@arclayer/app",
    "platform": "turbo run dev --filter=@arclayer/platform",
    "platform:build": "turbo run build --filter=@arclayer/platform",
    "platform:check": "turbo run build lint:check format:check typecheck test locale:check --filter=@arclayer/platform",
    "api": "turbo run dev --filter=@arclayer/api",
    "api:test": "pnpm -C apps/api test",
    "api:check": "turbo run lint:check format:check typecheck test --filter=@arclayer/api",
    "browser:install": "PLAYWRIGHT_BROWSERS_PATH=/tmp/arclayer-playwright pnpm exec playwright install chromium",
    "browser:acceptance": "node scripts/browser-acceptance/run.mjs",
    "hooks:install": "pnpm -C apps/api uv pre-commit install --hook-type pre-commit",
    "sdk:check": "turbo run typecheck test --filter=@arclayer/management-sdk",
    "cli:check": "turbo run lint format typecheck test build --filter=@arclayer/cli",
    "local:https-cert": "bash scripts/local-https/create-cert.sh",
    "code-review-engine": "pnpm -C scripts/code-review-engine run cli",
    "docker": "docker compose up -d --remove-orphans",
    "docker:devtools": "docker compose --profile devtools up -d"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/archiver": "catalog:",
    "@types/node": "catalog:",
    "@vitest/ui": "catalog:",
    "archiver": "catalog:",
    "lodash": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "penpal": "catalog:",
    "shadcn": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-react-inspector": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.24.0"
}
