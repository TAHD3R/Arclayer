{
  "name": "celestial-framework",
  "private": true,
  "scripts": {
    "dev": "turbo run dev jobs:worker --filter=@celestial/admin --filter=@celestial/api --filter=@celestial/portal",
    "dev:saas": "pnpm infra:saas && pnpm dev",
    "dev:self_host": "pnpm infra:self_host && pnpm dev",
    "build": "turbo run build --filter=@celestial/admin --filter=@celestial/portal",
    "format": "turbo run format --filter=@celestial/admin --filter=@celestial/api --filter=@celestial/portal",
    "check": "turbo run lint format typecheck test --filter=@celestial/admin --filter=@celestial/api --filter=@celestial/portal",
    "audit:quality": "python3 scripts/quality/audit_repo.py --repo-root . --out-md docs/audit/latest-quality-report.md",
    "audit:quality:strict": "python3 scripts/quality/audit_repo.py --repo-root . --out-md docs/audit/latest-quality-report.md --fail-on-findings",
    "admin": "turbo run dev --filter=@celestial/admin",
    "admin:build": "turbo run build --filter=@celestial/admin",
    "admin:check": "turbo run lint format typecheck test --filter=@celestial/admin",
    "portal": "turbo run dev --filter=@celestial/portal",
    "portal:build": "turbo run build --filter=@celestial/portal",
    "portal:check": "turbo run lint format typecheck --filter=@celestial/portal",
    "api": "turbo run dev --filter=@celestial/api",
    "api:test": "turbo run test --filter=@celestial/api  --ui=tui",
    "api:check": "turbo run lint format typecheck test --filter=@celestial/api",
    "infra:saas": "docker compose --profile saas up -d",
    "infra:self_host": "docker compose up -d"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/ui": "catalog:",
    "lodash": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.28.2"
}
