{
  "name": "celestial-framework",
  "private": true,
  "scripts": {
    "dev": "turbo run dev jobs:worker jobs:scheduler --filter=@celestial/admin --filter=@celestial/api",
    "dev:saas": "DEPLOYMENT_MODE=saas pnpm docker:saas && pnpm dev",
    "dev:selfhost": "pnpm docker:edge && pnpm dev",
    "dev:selfhost:min": "pnpm docker && pnpm dev",
    "build": "turbo run build --filter=@celestial/admin",
    "format": "turbo run format --filter=@celestial/admin --filter=@celestial/api",
    "check": "turbo run lint format typecheck test --filter=@celestial/admin --filter=@celestial/api",
    "admin": "turbo run dev --filter=@celestial/admin",
    "admin:build": "turbo run build --filter=@celestial/admin",
    "admin:check": "turbo run lint format typecheck test --filter=@celestial/admin",
    "api": "turbo run dev --filter=@celestial/api",
    "api:test": "pnpm -C apps/api test",
    "api:check": "turbo run lint format typecheck test --filter=@celestial/api",
    "docker": "docker compose up -d",
    "docker:saas": "docker compose --profile saas up -d",
    "docker:edge": "docker compose --profile edge up -d",
    "docker:devtools": "docker compose --profile devtools up -d"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/ui": "catalog:",
    "@types/archiver": "catalog:",
    "antd": "catalog:",
    "archiver": "catalog:",
    "lodash": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "penpal": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-react-inspector": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.28.2"
}
