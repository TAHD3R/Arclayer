{
  "name": "celestial-framework",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --filter=@celestial/admin --filter=@celestial/api",
    "build": "turbo run build --filter=@celestial/admin",
    "check": "turbo run lint format typecheck test --filter=@celestial/admin --filter=@celestial/api",
    "admin": "turbo run dev --filter=@celestial/admin",
    "admin:build": "turbo run build --filter=@celestial/admin",
    "admin:check": "turbo run lint format typecheck test --filter=@celestial/admin",
    "api": "turbo run dev --filter=@celestial/api",
    "api:test": "turbo run test --filter=@celestial/api",
    "api:migrate": "turbo run db:migrate --filter=@celestial/api",
    "api:upgrade": "turbo run db:upgrade --filter=@celestial/api",
    "api:check": "turbo run lint format typecheck test --filter=@celestial/api"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/ui": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.28.2"
}
