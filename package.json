{
  "name": "arclayer-framework",
  "private": true,
  "scripts": {
    "dev": "turbo run dev jobs:worker jobs:scheduler --filter=@arclayer/admin --filter=@arclayer/api",
    "dev:docker": "pnpm docker && pnpm dev",
    "build": "turbo run build --filter=@arclayer/admin",
    "format": "turbo run format --filter=@arclayer/admin --filter=@arclayer/api",
    "check": "turbo run lint format typecheck test --filter=@arclayer/admin --filter=@arclayer/api",
    "admin": "turbo run dev --filter=@arclayer/admin",
    "admin:build": "turbo run build --filter=@arclayer/admin",
    "admin:check": "turbo run lint format typecheck test --filter=@arclayer/admin",
    "api": "turbo run dev --filter=@arclayer/api",
    "api:test": "pnpm -C apps/api test",
    "api:check": "turbo run lint format typecheck test --filter=@arclayer/api",
    "docker": "docker compose up -d",
    "docker:devtools": "docker compose --profile devtools up -d"
  },
  "devDependencies": {
    "@types/archiver": "catalog:",
    "@types/node": "catalog:",
    "@vitest/ui": "catalog:",
    "archiver": "catalog:",
    "lodash": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "penpal": "catalog:",
    "shadcn": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-react-inspector": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.28.2"
}
