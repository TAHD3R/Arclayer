# Root Docker Compose environment.
#
# Copy to `.env` only when you need to pass provider keys into local Docker
# services such as LiteLLM. Keep real keys out of source control.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

ARCLAYER_APP_URL=https://app.arclayer.localhost
ARCLAYER_PLATFORM_URL=https://platform.arclayer.localhost
ARCLAYER_API_URL=https://api.arclayer.localhost
ARCLAYER_STORAGE_URL=https://storage.arclayer.localhost
ARCLAYER_RUSTFS_CONSOLE_URL=https://rustfs.arclayer.localhost
ARCLAYER_BASE_DOMAIN=arclayer.localhost
